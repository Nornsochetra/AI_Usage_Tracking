# Copy to .env and fill in real values. .env is gitignored — never commit it.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/
DB_USERNAME=postg
DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Server
SERVER_PORT=8081

# Anthropic (Claude Code proxy) — console.anthropic.com > Settings > API Keys
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=

# Gemini (Gemini CLI proxy) — aistudio.google.com > Get API Key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=
